# Enforce LF line endings for all text files on all platforms
* text=auto eol=lf

# Source code
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf

# Markup & styles
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.sass  text eol=lf

# Data & config
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.env   text eol=lf
*.env.* text eol=lf

# Shaders
*.glsl  text eol=lf
*.vert  text eol=lf
*.frag  text eol=lf

# Docs & misc text
*.md    text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf

# Binary assets — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.glb   binary
*.gltf  text eol=lf
*.ttf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.zip   binary
